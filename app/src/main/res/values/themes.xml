<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DroidPad" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/dp_primary</item>
        <item name="colorOnPrimary">@color/dp_on_primary</item>
        <item name="colorPrimaryContainer">@color/dp_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/dp_on_primary_container</item>
        <item name="android:statusBarColor">@color/dp_surface</item>
        <item name="android:navigationBarColor">@color/dp_surface</item>
    </style>

    <style name="Theme.DroidPad.Pad" parent="Theme.DroidPad">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.DroidPad.Full" parent="Theme.DroidPad">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
